<Window x:Class="Sklad.Views.MaterialOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sklad.Views"
        mc:Ignorable="d"
        Title="Přehled materiálu" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="5">
            <TextBlock Text="{Binding SelectedMaterial.Name}"/>
            <TextBlock Text="{Binding SelectedMaterial.SafetyStock}"/>
            <TextBlock Text="{Binding SelectedMaterial.UnitOfMeasure.Description}"/>
        </StackPanel>

        <GroupBox Header="Materiály" Grid.Column="1">

            <DataGrid ItemsSource="{Binding MaterialsCol}" IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedMaterial}"
                      >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding MaterialId}"/>
                    <DataGridTextColumn Header="Název" Width="*" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Pojistná" Binding="{Binding SafetyStock}"/>
                    <DataGridTextColumn Header="MJ" Binding="{Binding UnitOfMeasure.Description}"/>
                </DataGrid.Columns>
            </DataGrid>

        </GroupBox>

        <!-- Nahraď původní GroupBox "Palety" ve sloupci 2 tímto kódem: -->
        <GroupBox Header="Palety" Grid.Column="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding SelectedMaterial.Pallets}" 
                          IsReadOnly="True" AutoGenerateColumns="False" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding PalletId}"/>
                        <DataGridTextColumn Header="Místo" Width="*" Binding="{Binding StorageLocation}"/>
                        <DataGridTextColumn Header="Množství" Binding="{Binding Quantity}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <!-- Výchozí barva textu pro celý StackPanel -->
                            <Setter Property="TextElement.Foreground" Value="DarkBlue" />
                            <Setter Property="ToolTip" Value="{x:Null}" />

                            <Style.Triggers>
                                <!-- Trigger, který se aktivuje, pokud jsme pod pojistnou zásobou -->
                                <DataTrigger Binding="{Binding SelectedMaterial.IsBelowSafetyStock}" Value="True">
                                    <Setter Property="TextElement.Foreground" Value="Red" />
                                    <Setter Property="ToolTip" Value="Pozor: Jsme pod pojistnou zásobou!" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- TextBlocks už nesmí mít natvrdo nastavený Foreground, jinak by přebily styl -->
                    <TextBlock Text="Celkové množství: " FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedMaterial.TotalQuantity}" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedMaterial.UnitOfMeasure.Description, StringFormat=' {0}'}" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </GroupBox>

    </Grid>
</Window>
